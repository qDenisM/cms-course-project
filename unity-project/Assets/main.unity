  m_Name: 
  m_EditorClassIdentifier: 
  elementName: "\u0411\u041E\u041B\u042C\u0428\u041E\u0419 \u041F\u041E\u0420\u0428\u0415\u041D\u042C"
  description: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 (\u0440\u0430\u0431\u043E\u0447\u0438\u0439)
    \u043F\u043E\u0440\u0448\u0435\u043D\u044C \u2014 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0435\u0442
    \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E-\u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u043C
    \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0435. \u041F\u0430\u0440 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F
    \u0438 \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043E\u0440\u0448\u0435\u043D\u044C,
    \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u044F \u0443\u0441\u0438\u043B\u0438\u0435
    \u043D\u0430 \u0448\u0430\u0442\u0443\u043D \u0438 \u043A\u0440\u0438\u0432\u043E\u0448\u0438\u043F."
