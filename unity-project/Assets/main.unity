--- !u!114 &510420296
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510420290}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b68b39cfd86a5904bbb5ee5d3fdae1c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  practiceHintText: {fileID: 0}
  uiHub: {fileID: 510420291}
  intensity: {fileID: 510420294}
  engine: {fileID: 2123669820}
  practiceMode: {fileID: 510420297}
  task1: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 1. \u041E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0442\u0435\u0441\u044C
    \u0441 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \u0423\u0421\u0422\u0410\u041D\u041E\u0412\u041A\u0410."
  task2: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 2. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043F\u0430\u0440\u0430: 10%, 50% \u0438\u043B\u0438 100%."
  task3: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 3. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435
    \u0440\u044B\u0447\u0430\u0433 \u043F\u043E\u0434\u0430\u0447\u0438 \u043F\u0430\u0440\u0430
    \u0438 \u0434\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0433\u043E
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0430."
  task4: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 4. \u0417\u0430\u043F\u0438\u0448\u0438\u0442\u0435
    \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u041A\u041F\u0414, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0430 (\xB0/\u0441) \u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043F\u0430\u0440\u0430."
  task5: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 5. \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435
    \u043E\u043F\u044B\u0442 \u043F\u0440\u0438 \u0434\u0440\u0443\u0433\u043E\u0439
    \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043F\u0438\u0448\u0438\u0442\u0435
    \u0441\u0442\u0440\u043E\u043A\u0443."
  task6: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 6. \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0430
    \u043F\u0440\u0438 10%, 50% \u0438 100% \u043F\u0430\u0440\u0430."
  task7: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 7. \u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435
    \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0443."
