  m_Name: 
  m_EditorClassIdentifier: 
  elementName: "\u041C\u0410\u041B\u042B\u0419 \u041F\u041E\u0420\u0428\u0415\u041D\u042C"
  description: "\u041C\u0430\u043B\u044B\u0439 \u043F\u043E\u0440\u0448\u0435\u043D\u044C
    (\u0437\u043E\u043B\u043E\u0442\u043D\u0438\u043A, slide valve) \u2014 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
    \u043F\u0430\u0440: \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
    \u0435\u0433\u043E \u0442\u043E \u0432 \u043E\u0434\u043D\u0443, \u0442\u043E
    \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
    \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0430. \u041E\u0442 \u0435\u0433\u043E
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0437\u0430\u0432\u0438\u0441\u044F\u0442
    \u0444\u0430\u0437\u044B \u0432\u043F\u0443\u0441\u043A\u0430 \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430
    \u043F\u0430\u0440\u0430."
