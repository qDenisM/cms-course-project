--- !u!114 &667861874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667861872}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1.0220588, g: 0.9018166, b: 0.9018166, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1bcdffcb87cb42645a7eb6d57eccd7d3, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u0420\u0410\u0412\u0418\u041B\u0410 \u0420\u0410\u0411\u041E\u0422\u042B
    \u0421 \u0421\u0418\u041C\u0423\u041B\u042F\u0422\u041E\u0420\u041E\u041C\r\n\n1.
    \u0423\u0421\u0422\u0410\u041D\u041E\u0412\u041A\u0410 \u2014 \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043D\u0430 \u044D\u043B\u0435\u043C\u0435\u043D\u0442: \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
    \u0432\u043D\u0438\u0437\u0443, \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430
    \u043D\u0430 \u0441\u0445\u0435\u043C\u0435; \u0449\u0435\u043B\u0447\u043E\u043A
    \u2014 \u0440\u0430\u043A\u0443\u0440\u0441 \u043A\u0430\u043C\u0435\u0440\u044B.\r\n2.
    \u041F\u0420\u0410\u041A\u0422\u0418\u041A\u0410 \u2014 \u0440\u0435\u0436\u0438\u043C
    \u0437\u0430\u0434\u0430\u043D\u0438\u0439 \u0438 \u0442\u0430\u0431\u043B\u0438\u0446\u044B
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.\r\n3. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043F\u0430\u0440\u0430: 10%, 50% \u0438\u043B\u0438 100%.\r\n4. \u0417\u0430\u0442\u0435\u043C
    \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0440\u044B\u0447\u0430\u0433
    \u043F\u043E\u0434\u0430\u0447\u0438 \u043F\u0430\u0440\u0430. \u0411\u0435\u0437
    \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u043F\u0430\u0440 \u043D\u0435 \u043F\u043E\u0434\u0430\u0451\u0442\u0441\u044F.\r\n5.
    \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F
    1\u20137, \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438
    \u0432\u043D\u0438\u0437\u0443 \u044D\u043A\u0440\u0430\u043D\u0430.\r\n6. \u0417\u0430\u043F\u0438\u0441\u044C
    \u2014 \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 (\u041A\u041F\u0414,
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043C\u0430\u0445\u043E\u0432\u0438\u043A\u0430
    \xB0/\u0441, \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    %).\r\n7. \u0422\u0430\u0431\u043B\u0438\u0446\u0430 \u2014 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C/\u0441\u043A\u0440\u044B\u0442\u044C;
    \u041E\u0447\u0438\u0441\u0442\u043A\u0430 \u2014 \u0441\u0431\u0440\u043E\u0441
    \u0434\u0430\u043D\u043D\u044B\u0445.\r\n8. \u041F\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438
    \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0440\u044B\u0447\u0430\u0433
    \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
    \u0434\u043B\u044F \u043E\u0442\u0447\u0451\u0442\u0430."
